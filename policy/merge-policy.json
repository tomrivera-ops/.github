{
  "policy_version": "1",
  "gate_repository": "tomrivera-ops/.github",
  "gate_paths": [".github/*", "scripts/*", "policy/*", "*.py", "*.pyc", "*.pth", ".gitattributes", ".gitmodules",
                 "CODEOWNERS", "docs/MERGE-GATE.md", "validated.json", "evidence.json", "decision.json"],
  "gate_repository_mergeable_paths": ["*.md", "*.template"],
  "allowed_signers": "policy/founder-allowed-signers",
  "faraday_review_check": "faraday-review / governed-summary",
  "protected_paths": [".github/*", ".github/**", "*/.github/*", "CODEOWNERS", "*/CODEOWNERS", "schemas/*", "**/schemas/*",
                      "tools/guards/*", "policy/*", "*.lock", "package-lock.json", "pnpm-lock.yaml", "uv.lock",
                      "infra/*", "deploy/*", "*.tf", "Dockerfile", "*/Dockerfile"],
  "required_contexts": {}
}
